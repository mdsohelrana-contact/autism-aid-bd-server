generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//  ENUMS 
enum Locale {
  bn
  en
}

enum Role {
  ADMIN
  CUSTOMER
  STAFF
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum BannerStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

enum DeviceType {
  WEB
  MOBILE
  BOTH
}

enum BannerPage {
  HOME
  PRODUCT
  CATEGORY
  CART
  CHECKOUT
  CUSTOM
}

enum CouponStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
  REFUNDED_PENDING
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// NotificationType
enum NotificationType {
  ORDER_PLACED
  ORDER_CANCELLED
  ORDER_RETURNED
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_CONFIRMED
  ORDER_REFUNDED
  ORDER_PAID
  PROMOTION // Coupon, Discount, Offer
  SYSTEM_ALERT // Admin notice
  BLOG_POST // New blog published
}

// USER 
model User {
  id        String  @id @default(cuid())
  phone     String  @unique
  email     String? @unique
  name      String?
  role      Role    @default(CUSTOMER)
  password  String?
  isBanned  Boolean @default(false)
  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses          Address[]
  carts              Cart[]
  orders             Order[]
  reviews            Review[]
  notification       Notification[]
  product            Product[]
  productTranslation ProductTranslation[]
  productMedia       ProductMedia[]
  coupon             Coupon[]
  offerBanner        OfferBanner[]

  @@map("users")
}

//  ADDRESS 
model Address {
  id        String  @id @default(cuid())
  userId    String
  label     String?
  name      String
  phone     String
  city      String
  area      String
  lat       Float?
  lng       Float?
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@map("addresses")
}

//  PRODUCT 
model Product {
  id  String @id @default(cuid())
  sku String @unique

  userId String

  name        String
  status      ProductStatus @default(ACTIVE)
  brand       String?
  description String
  benefits    String
  // usage       String (Added after )
  ageMin      Int?
  ageMax      Int?

  averageRating Float @default(0)
  reviewCount   Int   @default(0)

  basePrice     Decimal  @default(0) @db.Decimal(12, 2)
  price         Decimal  @default(0) @db.Decimal(12, 2)
  discountPrice Decimal? @db.Decimal(12, 2)

  currency String @default("BDT")

  stockQty          Int     @default(0)
  lowStockThreshold Int     @default(3)
  isNew             Boolean @default(false)
  isTrending        Boolean @default(false)
  ratingAvg         Float   @default(0)
  ratingCount       Int     @default(0)

  deliveryDaysMin Int?
  deliveryDaysMax Int?

  specs Json?
  tags  String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  translations  ProductTranslation[]
  media         ProductMedia[]
  categories    ProductOnCategory[]
  orderItems    OrderItem[]
  reviews       Review[]
  stockLogs     StockLog[]
  cartItem      CartItem[]
  couponProduct CouponProduct[]

  @@index([status, createdAt])
  @@index([price])
  @@index([isTrending, isNew])
  @@index([ratingAvg, ratingCount])
  @@index([stockQty])
  @@map("products")
}

//  PRODUCT TRANSLATION 
model ProductTranslation {
  id          String  @id @default(cuid())
  productId   String
  userId      String
  locale      Locale
  name        String
  slug        String
  seoTitle    String?
  seoDesc     String?
  shortDesc   String?
  description String?
  usage       String?
  benefits    String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@unique([locale, slug])
  @@index([name])
  @@map("products_translations")
}

//  PRODUCT MEDIA 
model ProductMedia {
  id        String  @id @default(cuid())
  productId String
  userId    String
  url       String
  type      String?
  alt       String?

  createdAt DateTime @default(now())

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([userId])
  @@map("product_media")
}

//  CATEGORY 
model Category {
  id       String  @id @default(cuid())
  parentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent         Category?             @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children       Category[]            @relation("CategoryHierarchy")
  translations   CategoryTranslation[]
  products       ProductOnCategory[]
  CouponCategory CouponCategory[]

  @@map("categories")
}

model CategoryTranslation {
  id          String  @id @default(cuid())
  categoryId  String
  locale      Locale
  name        String
  slug        String
  description String?

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@unique([locale, slug])
  @@index([name])
  @@map("categories_translations")
}

model ProductOnCategory {
  productId  String
  categoryId String

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@map("products_categories")
}

//  CART 
model Cart {
  id     String @id @default(cuid())
  userId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  CartItem[]
  orders Order[]

  @@map("carts")
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String
  quantity  Int    @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@map("cart_items")
}

//  ORDER 
model Order {
  id             String      @id @default(cuid())
  userId         String
  cartId         String?
  addressId      String?
  status         OrderStatus @default(PENDING)
  total          Decimal     @default(0) @db.Decimal(12, 2)
  discount       Decimal     @default(0) @db.Decimal(12, 2)
  finalTotal     Decimal     @default(0) @db.Decimal(12, 2)
  shippingCharge Decimal     @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal     @default(0) @db.Decimal(12, 2)
  isPaid         Boolean     @default(false)

  couponId String?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cart    Cart?    @relation(fields: [cartId], references: [id], onDelete: SetNull)
  address Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)

  coupon   Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([isPaid])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  productId     String
  quantity      Int     @default(1)
  price         Decimal @default(0) @db.Decimal(12, 2)
  basePrice     Decimal @default(0) @db.Decimal(12, 2)
  discountPrice Decimal @default(0) @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([orderId, productId])
  @@map("order_items")
}

//  PAYMENT 
model Payment {
  id      String        @id @default(cuid())
  orderId String
  amount  Decimal       @default(0) @db.Decimal(12, 2)
  status  PaymentStatus @default(PENDING)
  method  String?

  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

//  REVIEW 
model Review {
  id        String  @id @default(cuid())
  userId    String
  productId String
  rating    Int     @default(5)
  comment   String?
  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@map("reviews")
}

//  STOCK LOG 
model StockLog {
  id        String  @id @default(cuid())
  productId String
  quantity  Int
  type      String
  note      String?

  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("stock_logs")
}

//  COUPON 
model Coupon {
  id       String     @id @default(cuid())
  code     String     @unique
  discount Decimal    @default(0) @db.Decimal(5, 2)
  type     CouponType @default(PERCENTAGE)

  minCartTotal Decimal? @db.Decimal(12, 2)

  validFrom  DateTime
  validUntil DateTime

  usageLimit   Int?
  usedCount    Int  @default(0)
  perUserLimit Int?

  status   CouponStatus @default(ACTIVE)
  isActive Boolean      @default(true)

  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  couponProduct  CouponProduct[]
  couponCategory CouponCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Order     Order[]

  @@index([code])
  @@index([isActive])
  @@index([status])
  @@map("coupons")
}

model CouponProduct {
  id        String @id @default(cuid())
  couponId  String
  productId String

  coupon  Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([couponId, productId])
  @@map("coupon_products")
}

model CouponCategory {
  id         String @id @default(cuid())
  couponId   String
  categoryId String

  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([couponId, categoryId])
  @@map("coupon_categories")
}

// OFFER BANNER
model OfferBanner {
  id       String  @id @default(cuid())
  slug     String  @unique @db.VarChar(150)
  title    String  @db.VarChar(255)
  subtitle String? @db.VarChar(255)
  imageUrl String? @db.Text
  linkUrl  String? @db.Text

  seoTitle String? @db.VarChar(255)
  seoDesc  String? @db.VarChar(500)

  status   BannerStatus @default(ACTIVE)
  priority Int          @default(0) // ordering for multiple banners

  startDate DateTime? // scheduled start
  endDate   DateTime? // scheduled end

  userId String
  // Relation with user
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  targetPage BannerPage? // HOME, PRODUCT, CATEGORY, CART, etc.
  deviceType DeviceType? // WEB, MOBILE, BOTH

  // Performance helpers
  isDeleted   Boolean @default(false) // soft delete
  impressions Int     @default(0) // how many times viewed
  clicks      Int     @default(0) // how many times clicked

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexing for speed 🚀
  @@index([status, startDate, endDate])
  @@index([priority])
  @@index([targetPage, deviceType])
  @@map("offer_banners")
}

//  BLOG 
model BlogPost {
  id     String     @id @default(cuid())
  status BlogStatus @default(DRAFT)
  cover  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations BlogPostTranslation[]

  @@map("blog_posts")
}

model BlogPostTranslation {
  id         String  @id @default(cuid())
  blogPostId String
  locale     Locale
  title      String
  slug       String
  excerpt    String?
  content    String?
  seoTitle   String?
  seoDesc    String?
  coverAlt   String?

  blogPost BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)

  @@unique([blogPostId, locale])
  @@unique([locale, slug])
  @@index([title])
  @@map("blog_post_translations")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String? // null -> global notification
  type      NotificationType
  title     String
  message   String
  link      String?
  read      Boolean          @default(false)
  delivered Boolean          @default(false) // Push / Email / SMS status
  meta      Json? // Extra data (orderId, productId etc.)
  createdAt DateTime         @default(now())
  readAt    DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}
