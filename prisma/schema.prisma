generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- ENUMS ----------
enum Locale {
  bn
  en
}

enum Role {
  CUSTOMER
  ADMIN
  EDITOR
  SUPPORT
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
}

enum PaymentMethod {
  BKASH
  NAGAD
  SSLCOMMERZ
  COD
}

enum PaymentStatus {
  INITIATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum DeliveryMethod {
  HOME_DELIVERY
  PICKUP_PARTNER
}

enum StockEventType {
  ORDER_PLACED
  ORDER_CANCELLED
  MANUAL_ADJUST
  RETURN_IN
}

// ---------- CORE USER ----------
model User {
  id           String   @id @default(cuid())
  phone        String   @unique
  email        String?  @unique
  name         String
  role         Role     @default(CUSTOMER)
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses Address[]
  orders    Order[]
  reviews   Review[]
  carts     Cart[]
  BlogPost  BlogPost[]

  @@index([role])
  @@index([phone])
}

// ---------- ADDRESS ----------
model Address {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String
  name       String
  phone      String
  line1      String
  line2      String?
  city       String
  area       String?
  postalCode String?
  country    String  @default("Bangladesh")
  lat        Float?
  lng        Float?
  isDefault  Boolean @default(false)
  Order      Order[]

  @@index([userId, isDefault])
  @@index([city, area])
}

// ---------- PARTNER CENTER ----------
model PartnerCenter {
  id      String  @id @default(cuid())
  code    String  @unique
  name    String
  address String
  lat     Float
  lng     Float
  phone   String?
  active  Boolean @default(true)

  orders Order[]

  @@index([active])
}

// ---------- TAXONOMY: Condition / Category / AgeRange / Tag ----------
model Condition {
  id        String                 @id @default(cuid())
  key       String                 @unique
  createdAt DateTime               @default(now())
  products  ProductOnCondition[]
  i18n      ConditionTranslation[]

  @@index([key])
}

model ConditionTranslation {
  id          String  @id @default(cuid())
  conditionId String
  locale      Locale
  name        String
  slug        String
  description String?

  condition Condition @relation(fields: [conditionId], references: [id], onDelete: Cascade)

  @@unique([conditionId, locale])
  @@unique([locale, slug])
  @@index([name])
}

model Category {
  id        String                @id @default(cuid())
  key       String                @unique
  parentId  String?
  parent    Category?             @relation("CategoryToSelf", fields: [parentId], references: [id])
  children  Category[]            @relation("CategoryToSelf")
  createdAt DateTime              @default(now())
  products  ProductOnCategory[]
  i18n      CategoryTranslation[]

  @@index([key])
  @@index([parentId])
}

model CategoryTranslation {
  id         String  @id @default(cuid())
  categoryId String
  locale     Locale
  name       String
  slug       String
  seoTitle   String?
  seoDesc    String?

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@unique([locale, slug])
  @@index([name])
}

model AgeRange {
  id       String                @id @default(cuid())
  key      String                @unique
  i18n     AgeRangeTranslation[]
  products Product[]

  @@index([key])
}

model AgeRangeTranslation {
  id         String @id @default(cuid())
  ageRangeId String
  locale     Locale
  name       String

  ageRange AgeRange @relation(fields: [ageRangeId], references: [id], onDelete: Cascade)

  @@unique([ageRangeId, locale])
}

model Tag {
  id       String           @id @default(cuid())
  key      String           @unique
  i18n     TagTranslation[]
  products ProductOnTag[]

  @@index([key])
}

model TagTranslation {
  id     String @id @default(cuid())
  tagId  String
  locale Locale
  name   String

  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([tagId, locale])
}

// ---------- PRODUCT ----------
model Product {
  id                String        @id @default(cuid())
  sku               String        @unique
  status            ProductStatus @default(ACTIVE)
  brand             String?
  ageRangeId        String?
  ageRange          AgeRange?     @relation(fields: [ageRangeId], references: [id])
  price             Decimal       @db.Decimal(12, 2)
  currency          String        @default("BDT")
  compareAtPrice    Decimal?      @db.Decimal(12, 2)
  stockQty          Int           @default(0)
  lowStockThreshold Int           @default(3)
  isNew             Boolean       @default(false)
  isTrending        Boolean       @default(false)
  ratingAvg         Float         @default(0)
  ratingCount       Int           @default(0)
  deliveryDaysMin   Int?
  deliveryDaysMax   Int?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  translations ProductTranslation[]
  media        ProductMedia[]
  specs        ProductSpec[]
  conditions   ProductOnCondition[]
  categories   ProductOnCategory[]
  tags         ProductOnTag[]
  orderItems   OrderItem[]
  reviews      Review[]
  stockLogs    StockLog[]
  relatedFrom  RelatedProduct[]     @relation("RelatedFrom")
  relatedTo    RelatedProduct[]     @relation("RelatedTo")
  CartItem     CartItem[]

  @@index([status, createdAt])
  @@index([price])
  @@index([isTrending, isNew])
  @@index([ratingAvg, ratingCount])
  @@index([stockQty])
}

// ---------- PRODUCT TRANSLATIONS ----------
model ProductTranslation {
  id          String  @id @default(cuid())
  productId   String
  locale      Locale
  name        String
  slug        String
  seoTitle    String?
  seoDesc     String?
  shortDesc   String?
  description String?
  usage       String?
  benefits    String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@unique([locale, slug])
  @@index([name])
}

// ---------- PRODUCT MEDIA ----------
model ProductMedia {
  id        String  @id @default(cuid())
  productId String
  type      String // image|video|youtube
  url       String
  position  Int     @default(0)
  alt       String?
  locale    Locale?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

// ---------- PRODUCT SPEC ----------
model ProductSpec {
  id        String @id @default(cuid())
  productId String
  key       String
  value     String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, key])
}

// ---------- RELATIONS MAPPING ----------
model ProductOnCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model ProductOnCondition {
  productId   String
  conditionId String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  condition   Condition @relation(fields: [conditionId], references: [id], onDelete: Cascade)

  @@id([productId, conditionId])
  @@index([conditionId])
}

model ProductOnTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

model RelatedProduct {
  id        String   @id @default(cuid())
  fromId    String
  toId      String
  relation  String? // e.g. "ACCESSORY", "SIMILAR", "ALTERNATIVE"
  createdAt DateTime @default(now())

  from Product @relation("RelatedFrom", fields: [fromId], references: [id])
  to   Product @relation("RelatedTo", fields: [toId], references: [id])

  @@unique([fromId, toId]) // prevent duplicate links
}

model StockLog {
  id        String         @id @default(cuid())
  productId String
  delta     Int // +ve: stock added, -ve: stock removed
  type      StockEventType
  note      String? // reason for stock change
  createdAt DateTime       @default(now())

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt]) // fast stock history queries
  @@index([type]) // fast filter by event type
}

// ---------- CART / WISHLIST ----------
model Cart {
  id        String     @id @default(cuid())
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId String? // guest carts
  locale    Locale     @default(bn)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]

  @@index([userId])
  @@index([sessionId])
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  productId String?
  qty       Int     @default(1)
  unitPrice Decimal @db.Decimal(12, 2)

  cart    Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([cartId, productId])
}

// ---------- ORDER / PAYMENT / SHIPMENT ----------
model Order {
  id                String         @id @default(cuid())
  orderNo           String         @unique
  userId            String?
  user              User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  status            OrderStatus    @default(PENDING)
  deliveryMethod    DeliveryMethod
  shippingAddressId String?
  shippingAddress   Address?       @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull)
  partnerCenterId   String?
  partnerCenter     PartnerCenter? @relation(fields: [partnerCenterId], references: [id], onDelete: SetNull)
  subtotal          Decimal        @db.Decimal(12, 2)
  discountTotal     Decimal        @default(0) @db.Decimal(12, 2)
  deliveryFee       Decimal        @default(0) @db.Decimal(12, 2)
  grandTotal        Decimal        @db.Decimal(12, 2)
  couponId          String?
  coupon            Coupon?        @relation(fields: [couponId], references: [id], onDelete: SetNull)
  paymentMethod     PaymentMethod
  paymentStatus     PaymentStatus  @default(INITIATED)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  items          OrderItem[]
  payments       Payment[]
  trackingEvents TrackingEvent[]

  @@index([status, createdAt])
  @@index([userId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String?
  name      String // snapshot for invoice
  locale    Locale  @default(bn)
  unitPrice Decimal @db.Decimal(12, 2)
  qty       Int
  lineTotal Decimal @db.Decimal(12, 2)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model Payment {
  id           String        @id @default(cuid())
  orderId      String
  method       PaymentMethod
  status       PaymentStatus @default(INITIATED)
  gatewayTxnId String?
  amount       Decimal       @db.Decimal(12, 2)
  rawPayload   Json?
  createdAt    DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, status, method])
}

model TrackingEvent {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  location  String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

// ---------- COUPON / DISCOUNT ----------
model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  description   String?
  active        Boolean   @default(true)
  percentageOff Float? // e.g., 10%
  amountOff     Decimal?  @db.Decimal(12, 2)
  minSubtotal   Decimal?  @db.Decimal(12, 2)
  maxUses       Int?
  usedCount     Int       @default(0)
  startsAt      DateTime?
  endsAt        DateTime?

  orders Order[]

  @@index([active, startsAt, endsAt])
}

// ---------- BLOG / AWARENESS ----------
model BlogCategory {
  id    String                    @id @default(cuid())
  key   String                    @unique
  posts BlogPost[]
  i18n  BlogCategoryTranslation[]

  @@index([key])
}

model BlogCategoryTranslation {
  id             String @id @default(cuid())
  blogCategoryId String
  locale         Locale
  name           String
  slug           String

  blogCategory BlogCategory @relation(fields: [blogCategoryId], references: [id], onDelete: Cascade)

  @@unique([blogCategoryId, locale])
  @@unique([locale, slug])
}

model BlogPost {
  id           String                @id @default(cuid())
  status       String                @default("PUBLISHED")
  authorId     String?
  author       User?                 @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  categoryId   String?
  category     BlogCategory?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  coverUrl     String?
  translations BlogPostTranslation[]

  @@index([status, createdAt])
}

model BlogPostTranslation {
  id         String  @id @default(cuid())
  blogPostId String
  locale     Locale
  title      String
  slug       String
  excerpt    String?
  content    String?
  seoTitle   String?
  seoDesc    String?

  blogPost BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)

  @@unique([blogPostId, locale])
  @@unique([locale, slug])
  @@index([title])
}

// ---------- FAQ ----------
model FAQ {
  id       String           @id @default(cuid())
  key      String           @unique
  i18n     FAQTranslation[]
  category String? // therapy/equipment-use/payment/shipping
  position Int              @default(0)
}

model FAQTranslation {
  id       String @id @default(cuid())
  faqId    String
  locale   Locale
  question String
  answer   String

  faq FAQ @relation(fields: [faqId], references: [id], onDelete: Cascade)

  @@unique([faqId, locale])
}

// ---------- OFFER BANNER ----------
model OfferBanner {
  id           String    @id @default(cuid())
  title        String
  message      String
  active       Boolean   @default(true)
  lat          Float?
  lng          Float?
  radiusKm     Float?
  regionCode   String?
  freeDelivery Boolean   @default(false)
  pickupHint   Boolean   @default(false)
  startsAt     DateTime?
  endsAt       DateTime?
  slug         String    @unique
  locale       Locale    @default(bn)
  createdAt    DateTime  @default(now())

  @@index([active, startsAt, endsAt])
  @@index([regionCode])
}

// REVIEW
model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int // 1..5
  title     String? // SEO friendly title
  body      String? // review content
  locale    Locale   @default(bn)
  createdAt DateTime @default(now())
  approved  Boolean  @default(true)

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId]) // এক user শুধুমাত্র একবার review দিতে পারবে
  @@index([productId, approved]) // approved filter query fast
  @@index([locale]) // multilingual filter
}

// ---------- NEWSLETTER ----------
model NewsletterSubscription {
  id        String   @id @default(cuid())
  email     String   @unique
  locale    Locale   @default(bn)
  createdAt DateTime @default(now())
}
