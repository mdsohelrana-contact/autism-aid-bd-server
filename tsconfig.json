{
  "compilerOptions": {
    "target": "es2020",                       
    "module": "commonjs",                     
    "moduleResolution": "node",               
    "outDir": "./dist",                       
    "rootDir": "./src",                       

    "strict": true,                           
    "esModuleInterop": true,                  
    "forceConsistentCasingInFileNames": true, 
    "skipLibCheck": true,                     
    "sourceMap": true                         
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
